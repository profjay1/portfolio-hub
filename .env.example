# Copy to .env for local development. NEVER commit .env. Values below are harmless placeholders.
# Variables are consumed by the backend (prefix HUB_) and by Docker Compose.

HUB_DB_URL=jdbc:postgresql://localhost:5432/hub
HUB_DB_USER=hub
HUB_DB_PASSWORD=change-me-locally

# Signing secret for tokens. Generate a long random value locally; never reuse it in production.
HUB_JWT_SECRET=change-me-locally-to-a-long-random-string

HUB_ADMIN_EMAIL=admin@example.test
HUB_ALLOWED_ORIGINS=http://localhost:4200
